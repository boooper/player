{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Madrify",
  "version": "0.1.0",
  "identifier": "com.madrify.player",
  "build": {
    "frontendDist": "../web/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run --cwd web dev"
  },
  "app": {
    "windows": [
      {
        "title": "Madrify",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "shadow": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:5173 https: http://*:*; img-src 'self' data: https: http://localhost:* http://*:*; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNUM2NkE0MkExRTEwOEMKUldTTUVCNHFwR1pjZzJ0Z2VrQTMrVGU2WTI1L0xrZ0h6cXNiR3FLOWY0ZmRXb09zbjA5Qm5NMTMK",
      "endpoints": ["https://github.com/boooper/player/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "publisher": "Madrify",
    "shortDescription": "A music player",
    "longDescription": "Madrify is a modern music player for media servers.",
    "category": "Music",
    "copyright": "© 2026 Madrify",
    "android": {
      "minSdkVersion": 26
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
